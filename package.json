{
  "name": "skill-academy",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Local control plane for AI agent skills",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "service": "node scripts/service.mjs",
    "app": "node scripts/app.mjs",
    "stop": "node scripts/stop-dev.mjs",
    "test:placements": "cd server && npx tsx ../scripts/test-placements.ts",
    "dev:server": "npm -w @skill-academy/server run dev",
    "dev:web": "npm -w @skill-academy/web run dev",
    "build": "npm -w @skill-academy/web run build",
    "typecheck": "npm -w @skill-academy/server run typecheck",
    "seed": "node scripts/seed.mjs",
    "bench:p1": "npx tsx scripts/bench-p1.ts",
    "fixtures": "bash scripts/fixture-check.sh"
  },
  "engines": {
    "node": ">=22.5"
  }
}
